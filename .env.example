# ==============================================================
# LOCAL OLLAMA LLM CONFIGURATION (EXCLUSIVE: llama3.2:latest)
# ==============================================================
MODEL_NAME=llama3.2:latest
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_REPEAT_PENALTY=1.1
LLM_NUM_CTX=8192
LLM_SEED=42
LLM_TIMEOUT=300

# ==============================================================
# YOUTUBE INTEGRATION (OPTIONAL)
# ==============================================================
# YouTube Data API v3 key (leave empty to use public oEmbed and transcript fallback)
YOUTUBE_API_KEY=

# ==============================================================
# STUDIO PROCESSING & SYSTEM LIMITS
# ==============================================================
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=120
MAX_CONCURRENT_JOBS=1
DEFAULT_OUTPUT_LANGUAGE=en
ENVIRONMENT=development
LOG_LEVEL=INFO
